# ═══════════════════════════════════════════════════════════
#  RETROVERSO — .gitignore 
# ═══════════════════════════════════════════════════════════

# ── Firebase (não versionar estado local / logs) ────────────
.firebase/
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-debug.*.log

# ── Lixo de sistema operacional ─────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
*/desktop.ini

# ── ROMs (nunca subir) ──────────────────────────────────────
roms/
*.sfc
*.smc
*.nes
*.gba
*.gbc
*.gb
*.n64
*.z64
*.v64
*.md
*.bin
*.sms
*.gg
*.nds
*.iso
*.chd
*.cue
*.pbp

# Exceções: .md aqui é ROM de Mega Drive, mas documentação deve subir
!README.md
!*/README.md
!LICENSE.md
!FIREBASE-SETUP.md
!COMO-USAR.md
!docs/**/*.md

# ── Backups / versões antigas (qualquer extensão) ───────────
*_original.*
*_old.*
*_backup.*
*_bkp.*
*.bak
*.orig
*~
*copy.*
*[0-9].png.bak

# ── Arquivos com "#" ou " - Copia" no nome (duplicatas) ─────
*#*
*Copia*
* - Cópia*
*copy*

# ── Páginas/módulos que não fazem parte do app publicado ────
# (isso só impede o GIT de versionar — NÃO impede o deploy.
#  O que controla o deploy é estar dentro de public/ ou não.)
cs16.html
retrotv.html
js/canais-tv.js
js/radio-player.js
js/radios.js
assets/tv.png
retroverso-capas/

# ── Scripts locais e diffs ──────────────────────────────────
push_git.bat
*.diff
*.patch

# ── Editores / ferramentas ──────────────────────────────────
.vscode/
.idea/
__pycache__/
*.pyc
node_modules/
.env
.venv/
venv/
